@model ShopTARgv24.Core.Dto.AccuLocationWeatherResultDto

<h1>AccuWeather Information</h1>

@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>@Model.CityName</h3>
                </div>
                <div class="card-body">
                    <h4>Location Information</h4>
                    <p><strong>City:</strong> @Model.CityName</p>
                    <p>AccuWeather location data retrieved successfully!</p>
                    <p class="text-muted">Note: This demonstrates successful connection to AccuWeather API for location search.</p>
                </div>
                <div class="card-footer">
                    <small class="text-muted">Data provided by AccuWeather</small>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Weather" asp-action="Index" class="btn btn-primary">Back to Search</a>
    </div>
</div>