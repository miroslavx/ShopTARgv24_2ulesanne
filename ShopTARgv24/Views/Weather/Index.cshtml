@model ShopTARgv24.Models.Weather.AccuWeatherSearchViewModel

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <h1>AccuWeather Search</h1>
            <form method="post" asp-action="SearchCity">
                <div class="form-group">
                    <h2>Search the forecast in a city (AccuWeather)</h2>
                    <label asp-for="CityName" style="font-family: Arial"></label>
                    <input asp-for="CityName" class="form-control" placeholder="Enter city name..." />
                    <span asp-validation-for="CityName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Search with AccuWeather</button>
                </div>
            </form>
        </div>

        <div class="col-md-6">
            <h1>OpenWeather Search</h1>
            <form method="post" asp-action="SearchCityOpenWeather">
                <div class="form-group">
                    <h2>Search the forecast in a city (OpenWeather)</h2>
                    <label for="CityName" style="font-family: Arial">City Name</label>
                    <input name="CityName" class="form-control" placeholder="Enter city name..." />
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success">Search with OpenWeather</button>
                </div>
            </form>
        </div>
    </div>
</div>