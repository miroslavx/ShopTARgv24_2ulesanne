@model ShopTARgv24.Models.RealEstates.RealEstateCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>Update</h1>
}
else
{
    <h1>Create</h1>
}

<div>
    <form method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreateAt" type="hidden" />
        <input asp-for="ModifiedAt" type="hidden" />

        <div class="form-group row">
            <label asp-for="Area" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Area" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Location" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Location" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="RoomNumber" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="BuildingType" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Images</label>
            <div class="col-sm-5">
                <div class="custom-file">
                    <input asp-for="Files" class="form-control" multiple type="file" accept="image/*" />
                </div>
            </div>
        </div>

        @if (Model.Id.HasValue && Model.Image.Any())
        {
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Current Images</label>
                <div class="col-sm-10">
                    <div class="row">
                        @foreach (var image in Model.Image)
                        {
                            <div class="col-md-3 mb-3">
                                <div class="card">
                                    <img src="@image.Image" class="card-img-top" style="height: 200px; object-fit: cover;" />
                                    <div class="card-body p-2">
                                        <p class="card-text small">@image.ImageTitle</p>
                                        <div class="form-check">
                                            <input class="form-check-input image-checkbox" type="checkbox" value="@image.Id" name="selectedImages">
                                            <label class="form-check-label small">
                                                Select for deletion
                                            </label>
                                        </div>
                                        <button type="button" class="btn btn-danger btn-sm mt-1" onclick="removeImage('@image.Id', '@Model.Id')">
                                            Remove This Image
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-3">
                        <button type="button" class="btn btn-warning" onclick="removeSelectedImages('@Model.Id')">
                            Remove Selected Images
                        </button>
                        <button type="button" class="btn btn-info" onclick="selectAll()">
                            Select All
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="deselectAll()">
                            Deselect All
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (Model.Id.HasValue)
        {
            <input asp-action="update" asp-controller="realestate" type="submit" class="btn btn-primary" value="Update" />
        }
        else
        {
            <input asp-action="create" asp-controller="realestate" type="submit" class="btn btn-primary" value="Create" />
        }
        <a asp-action="Index" asp-controller="realestate" class="btn btn-success">Back</a>

    </form>
</div>

<script>
    function removeImage(imageId, realEstateId) {
        if (confirm('Are you sure you want to remove this image?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("RemoveImage", "RealEstate")';

            var imageIdInput = document.createElement('input');
            imageIdInput.type = 'hidden';
            imageIdInput.name = 'imageId';
            imageIdInput.value = imageId;

            var realEstateIdInput = document.createElement('input');
            realEstateIdInput.type = 'hidden';
            realEstateIdInput.name = 'realEstateId';
            realEstateIdInput.value = realEstateId;

            form.appendChild(imageIdInput);
            form.appendChild(realEstateIdInput);
            document.body.appendChild(form);
            form.submit();
        }
    }

    function removeSelectedImages(realEstateId) {
        var checkboxes = document.querySelectorAll('.image-checkbox:checked');
        if (checkboxes.length === 0) {
            alert('Please select at least one image to remove.');
            return;
        }

        if (confirm('Are you sure you want to remove ' + checkboxes.length + ' selected image(s)?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("RemoveSelectedImages", "RealEstate")';

            checkboxes.forEach(function(checkbox) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedImages';
                input.value = checkbox.value;
                form.appendChild(input);
            });

            var realEstateIdInput = document.createElement('input');
            realEstateIdInput.type = 'hidden';
            realEstateIdInput.name = 'realEstateId';
            realEstateIdInput.value = realEstateId;
            form.appendChild(realEstateIdInput);

            document.body.appendChild(form);
            form.submit();
        }
    }

    function selectAll() {
        var checkboxes = document.querySelectorAll('.image-checkbox');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = true;
        });
    }

    function deselectAll() {
        var checkboxes = document.querySelectorAll('.image-checkbox');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = false;
        });
    }
</script>