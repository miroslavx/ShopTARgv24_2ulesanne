@model ShopTARgv24.Models.Kindergartens.KindergartenCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>Update Kindergarten</h1>
}
else
{
    <h1>Create Kindergarten</h1>
}

<div>
    <form method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="ModifiedAt" type="hidden" />

        <div class="form-group row">
            <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="GroupName" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="KindergartenName" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Teacher" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Teacher" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="ChildrenCount" class="form-control" type="number" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="EstablishedDate" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="EstablishedDate" class="form-control" type="date" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Address" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Address" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="ContactPhone" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="ContactPhone" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Email" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" type="email" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Description" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Images</label>
            <div class="col-sm-5">
                <div class="custom-file">
                    <input asp-for="Files" class="form-control" multiple type="file" accept="image/*" />
                </div>
            </div>
        </div>

        @if (Model.Id.HasValue && Model.Images.Any())
        {
            <div class="form-group row">
                <label class="col-sm-2 col-form-label">Current Images</label>
                <div class="col-sm-10">
                    <div class="row">
                        @foreach (var image in Model.Images)
                        {
                            <div class="col-md-3 mb-3">
                                <div class="card">
                                    <img src="@image.Image" class="card-img-top" style="height: 200px; object-fit: cover;" />
                                    <div class="card-body p-2">
                                        <p class="card-text small">@image.ImageTitle</p>
                                        <div class="form-check">
                                            <input class="form-check-input image-checkbox" type="checkbox" value="@image.Id" name="selectedImages" />
                                            <label class="form-check-label small">
                                                Select for deletion
                                            </label>
                                        </div>
                                        <button type="button" class="btn btn-danger btn-sm mt-1" onclick="removeImage('@image.Id', '@Model.Id')">
                                            Remove This Image
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="mt-3">
                        <button type="button" class="btn btn-warning" onclick="removeSelectedImages('@Model.Id')">
                            Remove Selected Images
                        </button>
                        <button type="button" class="btn btn-info" onclick="selectAll()">
                            Select All
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="deselectAll()">
                            Deselect All
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (Model.Id.HasValue)
        {
            <button type="submit" class="btn btn-primary">Update</button>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Create</button>
        }
        <a asp-action="Index" asp-controller="kindergarten" class="btn btn-success">Back</a>

    </form>
</div>

<script>
    function removeImage(imageId, kindergartenId) {
        if (confirm('Are you sure you want to remove this image?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("RemoveImage", "Kindergarten")';
            
            var imageIdInput = document.createElement('input');
            imageIdInput.type = 'hidden';
            imageIdInput.name = 'imageId';
            imageIdInput.value = imageId;
            
            var kindergartenIdInput = document.createElement('input');
            kindergartenIdInput.type = 'hidden';
            kindergartenIdInput.name = 'kindergartenId';
            kindergartenIdInput.value = kindergartenId;
            
            form.appendChild(imageIdInput);
            form.appendChild(kindergartenIdInput);
            document.body.appendChild(form);
            form.submit();
        }
    }

    function removeSelectedImages(kindergartenId) {
        var checkboxes = document.querySelectorAll('.image-checkbox:checked');
        if (checkboxes.length === 0) {
            alert('Please select at least one image to remove.');
            return;
        }
        
        if (confirm('Are you sure you want to remove ' + checkboxes.length + ' selected image(s)?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("RemoveSelectedImages", "Kindergarten")';
            
            checkboxes.forEach(function(checkbox) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedImages';
                input.value = checkbox.value;
                form.appendChild(input);
            });
            
            var kindergartenIdInput = document.createElement('input');
            kindergartenIdInput.type = 'hidden';
            kindergartenIdInput.name = 'kindergartenId';
            kindergartenIdInput.value = kindergartenId;
            form.appendChild(kindergartenIdInput);
            
            document.body.appendChild(form);
            form.submit();
        }
    }

    function selectAll() {
        var checkboxes = document.querySelectorAll('.image-checkbox');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = true;
        });
    }

    function deselectAll() {
        var checkboxes = document.querySelectorAll('.image-checkbox');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = false;
        });
    }
</script>